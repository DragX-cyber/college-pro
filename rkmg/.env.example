# RKMG gateway secrets — copy to rkmg/.env and fill in. rkmg/.env is git-ignored.
# The gateway loads this file on start (see src/gateway/index.ts loadDotEnv).

# DeepSeek API key for the "strong" (decision/planning) tier in config/models.yaml.
# Get one at https://platform.deepseek.com/ . Without it, the strong tier fails auth.
DEEPSEEK_API_KEY=

# If you point the strong tier at a different OpenAI-compatible provider instead,
# set that tier's api_key_env in models.yaml to match a variable you define here.
# EXAMPLE_PROVIDER_API_KEY=
