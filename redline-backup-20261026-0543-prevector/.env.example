# REDLINE environment
# Copy this file to .env  (cp .env.example .env) — then run: bun run db:push

# SQLite database. Relative paths are resolved against prisma/schema.prisma,
# so "file:../db/custom.db" points at <project>/db/custom.db on any OS.
# (If unset, the core falls back to <project>/db/custom.db automatically.)
DATABASE_URL=file:../db/custom.db
